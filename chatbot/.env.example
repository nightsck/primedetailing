# KI-Anbieter: anthropic (Standard) | bedrock (AWS Frankfurt, EU) | demo (ohne KI)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Für Bedrock: AWS-Zugangsdaten wie üblich (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# und in config/bot.config.json "bedrockModell" eintragen (Modell-ID aus der Bedrock-Konsole).

PORT=8787
# Websites, die das Widget nutzen dürfen (kommagetrennt). Leer = alle (nur zum Testen!)
ALLOWED_ORIGINS=https://primedetailing.eu,https://www.primedetailing.eu

# Notbremse: 1 = Chat sofort pausieren
KILL_SWITCH=0

# Versand der Anfragen. Am einfachsten FormSubmit (wie das Website-Formular):
# Anfragen per Web3Forms (Empfänger im Web3Forms-Dashboard, Key ist öffentlich)
WEB3FORMS_KEY=c7958793-0cd7-4107-9c71-becdc1ee3948
# Alternative: FORMSUBMIT_ZIEL=support@primedetailing.eu
# Gesprächsverlauf signieren (lange Zufallszeichenkette)
SESSION_SECRET=

# Alternativ SMTP (nur unter Node, nicht auf Cloudflare):
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=support@primedetailing.eu
SMTP_PASS=
SMTP_FROM=support@primedetailing.eu
ANFRAGE_EMPFAENGER=support@primedetailing.eu

# Stufe 2 (optional): WhatsApp-Benachrichtigung an den Inhaber über die WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_INHABER=
WHATSAPP_TEMPLATE=neue_anfrage
