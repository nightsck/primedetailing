# Kopieren nach .env (im selben Ordner) und ausfüllen. Die Datei .env NIE ins Repo legen.
# Erklärung zu jedem Schlüssel: chatbot/SECRETS.md

# Adresse, unter der der Server erreichbar ist (DNS: A-Eintrag auf die Server-IP)
DOMAIN=bots.example.de

# KI: Anthropic direkt …
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# … oder AWS Bedrock in Frankfurt (Daten bleiben in der EU): LLM_PROVIDER=bedrock,
# dazu AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY und bedrockModell in config/bot.config.json

# Lange Zufallszeichenkette (z. B. aus: openssl rand -hex 32). Nicht mehr ändern, sonst sind alle abgemeldet.
SESSION_SECRET=

# Wer ins Admin-Panel darf (kommagetrennt)
ADMIN_LOGIN=

# Mailversand über Brevo (Anfragen, Bewerbungen, Anmelde-Code)
BREVO_API_KEY=
MAIL_ABSENDER=
MAIL_TAGESLIMIT=300

# Websites, die die ALTEN Adressen (/api/chat von Prime Detailing) nutzen dürfen.
# Für neue Kunden steht die Website in ihrer Konfiguration.
ALLOWED_ORIGINS=https://primedetailing.eu,https://www.primedetailing.eu

# Notbremse: 1 = alle Bots sofort pausieren (danach: docker compose up -d)
KILL_SWITCH=0
