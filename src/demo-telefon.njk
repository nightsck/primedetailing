<link rel="stylesheet" href="/assets/demo.css?v={{ build.version }}">
<style>
  .tel-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px; align-items: start; margin-top: 8px; }
  @media (max-width: 860px) { .tel-grid { grid-template-columns: 1fr; } }
  .tel-card { background: var(--sheet); border: 1px solid var(--line); border-radius: var(--r); padding: 24px; }
  .tel-card h2 { font-size: 26px; margin-bottom: 8px; }
  .tel-card p { margin: 0 0 12px; color: var(--ink-2); }
  .tel-start { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .tel-start elevenlabs-convai { display: block; }
  .tel-try { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 8px; }
  .tel-try li { border-left: 3px solid var(--signal); padding: 6px 12px; background: var(--paper); font-size: 15px; }
  .tel-steps { margin: 0; padding-left: 20px; color: var(--ink-2); }
  .tel-steps li + li { margin-top: 8px; }
  .tel-steps b { color: var(--ink); }
  .tel-hint { font-size: 13px; color: var(--muted); margin-top: 16px; }
</style>
