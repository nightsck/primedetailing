<meta name="description" content="Vorführung: Ein KI-Telefonassistent nimmt Anrufe an, nennt freie Termine aus dem echten Kalender und bucht sie.">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#1B1D1F">
