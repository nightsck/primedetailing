{%- set waLink = "https://wa.me/" + site.whatsapp + "?text=" + (site.whatsapp_text | urlencode) -%}
<!doctype html>
<html lang="de" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ titel or site.seo_titel }}</title>
<meta name="description" content="{{ beschreibung or site.seo_beschreibung }}">
<link rel="canonical" href="https://primedetailing.eu{{ page.url }}">
{% if noindex %}<meta name="robots" content="noindex">
{% endif %}<meta name="theme-color" content="#0d0e0f">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.png" type="image/png" sizes="64x64">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:locale" content="de_DE">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ titel or site.seo_titel }}">
<meta property="og:description" content="{{ beschreibung or site.seo_beschreibung }}">
<meta property="og:url" content="https://primedetailing.eu{{ page.url }}">
<meta property="og:image" content="https://primedetailing.eu/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-tight.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/style.css">
<script>document.documentElement.classList.remove('no-js')</script>
{% block head %}{% endblock %}
</head>
<body>
<a class="skip" href="#main">Zum Inhalt springen</a>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
  <symbol id="i-wa" viewBox="0 0 24 24"><path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43s.17-.25.25-.41.04-.31-.02-.43c-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28Z"/></symbol>
  <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2 4 1.5V19a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 6.5 12 13l8.5-6.5" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="i-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></symbol>
  <symbol id="i-fleet" viewBox="0 0 24 24"><path d="M3 16v-4l2-5h10l3 5h1.5a1.5 1.5 0 0 1 1.5 1.5V16h-2M3 16h2m4 0h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7" cy="16.5" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="16.5" r="2" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 11v5.5M12 7.6v.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
</svg>

{%- set home = "" if page.url == "/" else "/" %}
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="{{ site.name }} – Startseite">Prime <span>Detailing</span></a>
    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        <li><a href="{{ home }}#leistungen">Leistungen</a></li>
        <li><a href="{{ home }}#preise">Preise</a></li>
        {% if rechner.aktiv %}<li><a href="{{ home }}#rechner">Preisrechner</a></li>{% endif %}
        <li><a href="{{ home }}#team">Über uns</a></li>
        <li><a href="{{ home }}#faq">FAQ</a></li>
      </ul>
    </nav>
    <a class="btn btn-primary btn-sm header-cta" href="{{ home }}#kontakt">Termin anfragen</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menü öffnen">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile Navigation" hidden>
  <a href="{{ home }}#leistungen">Leistungen</a>
  <a href="{{ home }}#preise">Preise</a>
  {% if rechner.aktiv %}<a href="{{ home }}#rechner">Preisrechner</a>{% endif %}
  <a href="{{ home }}#team">Über uns</a>
  <a href="{{ home }}#faq">FAQ</a>
  <a class="btn btn-primary btn-block" href="{{ home }}#kontakt">Termin anfragen</a>
</nav>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/">Prime <span>Detailing</span></a>
        <p style="margin-top:14px;max-width:36ch">Mobile Fahrzeugaufbereitung in {{ site.einsatzgebiet }}.</p>
      </div>
      <div>
        <h2>Seite</h2>
        <ul>
          <li><a href="{{ home }}#leistungen">Leistungen</a></li>
          <li><a href="{{ home }}#preise">Preise</a></li>
          <li><a href="{{ home }}#kontakt">Kontakt</a></li>
          <li><a href="/feedback/">Feedback geben</a></li>
        </ul>
      </div>
      <div>
        <h2>Rechtliches</h2>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {{ "" | jahr }} {{ site.firma }}</span>
      <span>Ohne Cookies, ohne Tracking.</span>
    </div>
  </div>
</footer>

{% if page.url == "/" %}
<div class="action-bar" aria-label="Schnellkontakt">
  <a class="btn btn-ghost" href="tel:{{ site.telefon | tel }}"><svg aria-hidden="true"><use href="#i-phone"/></svg> Anrufen</a>
  <a class="btn btn-primary" href="{{ waLink }}" target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#i-wa"/></svg> WhatsApp</a>
</div>
{% endif %}

<script src="/assets/main.js" defer></script>
{% if site.chatbot_url %}<script src="{{ site.chatbot_url }}/widget.js" defer></script>{% endif %}
</body>
</html>
